<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

    <Properties>
        <Property name="patron">%d{dd/MM/yyyy HH:mm:ss.SSS} %-5level %c{1} - %msg%n</Property>
        <Property name="carpetaRuntime">logs/runtime</Property>
        <Property name="carpetaEvidencias">logs/evidencias</Property>
    </Properties>

    <Appenders>
        <Console name="Consola" target="SYSTEM_OUT">
            <PatternLayout pattern="${patron}"/>
        </Console>

        <RollingFile name="Runtime"
                     fileName="${carpetaRuntime}/aplicacion.log"
                     filePattern="${carpetaRuntime}/aplicacion-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${patron}"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="20 KB"/>
            </Policies>
            <DefaultRolloverStrategy max="5"/>
        </RollingFile>

        <File name="Evidencia"
              fileName="${carpetaEvidencias}/ejecucion_${date:dd-MM-yyyy_HH-mm-ss}.log">
            <PatternLayout pattern="${patron}"/>
        </File>
    </Appenders>

    <Loggers>
        <Logger name="es.joselyn.proyecto" level="DEBUG"/>
        <Logger name="com.zaxxer.hikari" level="INFO"/>
        <Root level="INFO">
            <AppenderRef ref="Consola" level="INFO"/>
            <AppenderRef ref="Runtime"/>
            <AppenderRef ref="Evidencia"/>
        </Root>
    </Loggers>
</Configuration>